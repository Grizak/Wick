let x: int = 4*8
{
  let y = 24
  x = x+y
}

if x < 8 {
  exit(0)
} else {
  x = x+1
}

// C-style for loop — sum 1 to 10
let sum = 0
for let i = 1; i <= 10; i = i + 1 {
    sum = sum + i
}
// sum should be 55

// While-style loop — divide by 2 until < 10
let y = 200
for y > 10 {
    y = y / 2
}
// y should be 6 (200 -> 100 -> 50 -> 25 -> 12 -> 6)

// Test break — sum even numbers up to 20, stop at 14
let bsum = 0
for let j = 2; j <= 20; j = j + 2 {
    if j > 14 {
        break
    }
    bsum = bsum + j
}
// bsum = 2+4+6+8+10+12+14 = 56

// Test continue — sum only odd numbers from 1 to 10
let osum = 0
for let k = 1; k <= 10; k = k + 1 {
    if k == 2 {
        continue
    }
    if k == 4 {
        continue
    }
    if k == 6 {
        continue
    }
    if k == 8 {
        continue
    }
    if k == 10 {
        continue
    }
    osum = osum + k
}
// osum = 1+3+5+7+9 = 25

exit(2*x+44*16+sum+y+bsum+osum)
// 114 + 704 + 55 + 6 + 56 + 25 = 960
// 960 % 256 = 192