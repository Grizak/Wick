import "math.wk"

// Test import c
@extern("c", libs = "c")
fn puts(message: *i8): i32

let sum = fn(upper: i64 = 10): i64 {
	let sum = 0
	for let k = 1; k <= upper; k = k + 1 {
		sum = sum + k
	}
	return sum
}

// 1+2+3+4+...+19+20 = 210
let s = math.divide(sum(20), 21)

let n = puts("hi")

exit(s+n) // echo $? == 13
